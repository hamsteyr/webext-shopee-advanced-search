{
	"manifest_version": 3,
	"name": "Shopee Advanced Search",
	"version": "2.0.0",
	"description": "Filter search results containing ALL specified words, supporting word exclusion and minimum sold.",
	"homepage_url": "https://github.com/hamsteyr/webext-shopee-advanced-search",
	"author": "hamsteyr",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "96": "icons/96.png",
        "128": "icons/128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "include_globs": ["https://shopee.*/*"],
            "js": ["content.js"]
        }
    ]
}
